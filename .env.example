# Vercel environment variables for preview deployments
# Use a pooled connection string from Neon or Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional direct connection string for migrations (if your stack needs it)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# App URL provided by Vercel after deployment
NEXT_PUBLIC_APP_URL="https://your-project-name.vercel.app"
